ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# --pubmed retrieval (NCBI E-utilities). NCBI asks unauthenticated callers to
# identify themselves with a real contact email and stay under ~3 req/s; an
# optional API key raises that limit. Both are optional — without them PubMed
# still works at the lower anonymous rate.
PUBMED_EMAIL=you@example.com
PUBMED_API_KEY=
